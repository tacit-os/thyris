#!/bin/bash
# Checks what needs the real engine, the key classes (PLAN.md 5) and the lifecycle:
#   tools/check-engine [group ...]     (no group: all of them; the groups are in qml/EngineCheck.qml)
# Builds build-dev first if needed (-j2, nice; BROWSER_BUILD=build for the release build). Runs offscreen on
# a throwaway data dir; prints one line per check and exits non-zero if any failed.
set -eu
root=$(dirname "$(dirname "$(readlink -f "$0")")")
# build-dev keeps the QML as source (BROWSER_DEV in CMakeLists.txt), so a QML edit rebuilds in about a second
dir=${BROWSER_BUILD:-build-dev}
dev=OFF; [ "$dir" = build-dev ] && dev=ON
cmake -S "$root" -B "$root/$dir" -G Ninja -DCMAKE_BUILD_TYPE=Release -DBROWSER_DEV=$dev >/dev/null
if ! log=$(nice cmake --build "$root/$dir" -j2 2>&1); then
    printf '%s\n' "$log" >&2
    exit 1
fi
set -o pipefail
# Chromium's own screen: a private X server (a headless Weston's Xwayland, nobody's desktop). On its headless platform
# Chromium denies every permission prompt before the browser hears of it (PermissionRequestManager::AddRequest), so the
# notification and location asks could not be checked (2026-10-15). The browser takes it as CHECK_X_DISPLAY.
xlog=$(mktemp); sock=check-$$
snd="" sndpids=""
weston --backend=headless --xwayland --shell=kiosk --socket=$sock --no-config --idle-time=0 >"$xlog" 2>&1 & weston=$!
trap 'kill $weston $sndpids 2>/dev/null || true; rm -f "$xlog"; [ -z "$snd" ] || rm -rf "$snd"' EXIT
for i in $(seq 50); do x=$(grep -o 'xserver listening on display :[0-9]*' "$xlog" | grep -o ':[0-9]*$' || true); [ -n "$x" ] && break; sleep 0.1; done
[ -n "$x" ] || { echo "check-engine: the private X server did not start" >&2; exit 1; }
# The sound group's own sound server: PipeWire, WirePlumber with no device monitors, and pipewire-pulse, in a private
# runtime dir that becomes the browser's (CHECK_RUNTIME_DIR), with one speaker, a null sink called check_speaker. A
# page's sound goes where it would on a desktop, $XDG_RUNTIME_DIR/pulse/native, is recorded there, and never reaches a
# real device. The daemons get that dir as their home and only the stock configs, so none of this machine's own (a
# tuned speaker chain in ~/.config/pipewire) is loaded.
sound=()
if [ $# = 0 ] || printf '%s\n' "$@" | grep -qx sound; then
    snd=$(mktemp -d)
    mkdir -p "$snd/wireplumber/wireplumber.conf.d"
    printf '%s\n' 'wireplumber.profiles = { main = { monitor.alsa = disabled, monitor.alsa-midi = disabled,' \
        'monitor.bluez = disabled, monitor.bluez-midi = disabled, monitor.v4l2 = disabled, monitor.libcamera = disabled } }' \
        > "$snd/wireplumber/wireplumber.conf.d/check.conf"
    alone() { env -u DBUS_SESSION_BUS_ADDRESS -u DISPLAY -u WAYLAND_DISPLAY -u PIPEWIRE_REMOTE -u PULSE_SERVER -u PIPEWIRE_RUNTIME_DIR \
        HOME="$snd" XDG_RUNTIME_DIR="$snd" XDG_CONFIG_HOME="$snd/config" XDG_STATE_HOME="$snd/state" \
        PIPEWIRE_CONFIG_DIR=/usr/share/pipewire WIREPLUMBER_CONFIG_DIR="$snd/wireplumber:/usr/share/wireplumber" "$@"; }
    alone pipewire >"$snd/pipewire.log" 2>&1 & sndpids=$!
    for i in $(seq 50); do [ -S "$snd/pipewire-0" ] && break; sleep 0.1; done
    alone wireplumber >"$snd/wireplumber.log" 2>&1 & sndpids="$sndpids $!"
    alone pipewire-pulse >"$snd/pulse.log" 2>&1 & sndpids="$sndpids $!"
    for i in $(seq 50); do [ -S "$snd/pulse/native" ] && break; sleep 0.1; done
    alone pactl load-module module-null-sink sink_name=check_speaker sink_properties=device.description=check-speaker >/dev/null \
        && alone pactl set-default-sink check_speaker \
        || { echo "check-engine: the sound group's sound server did not start (pipewire, wireplumber, pipewire-pulse, pactl)" >&2; exit 1; }
    sound=(CHECK_RUNTIME_DIR="$snd")
fi
env -u PULSE_SERVER -u PIPEWIRE_REMOTE "${sound[@]}" CHECK_X_DISPLAY=$x THYRIS_OUTER_XDG_DATA_HOME=/var/empty/outer-data QT_FORCE_STDERR_LOGGING=1 timeout 1800 "$root/$dir/browser" --check-engine "$@" 2>&1 \
    | { grep -vE 'default value of option force_gl_vendor|Vulkan|GPU vendor|GPUInfo|Icon theme|no filter lists' || true; }
